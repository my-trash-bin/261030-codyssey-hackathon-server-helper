# ─────────────────────────────────────────────────────────────
# 2026 해커톤 서버 접속 설정  (복사해서 .env 로 저장 후 값을 채우세요)
#   cp .env.example .env
#
# ⚠️  .env 파일은 절대 커밋되지 않습니다 (.gitignore 등록됨).
#     VPN/서버 비밀번호·OTP를 타인과 공유하지 마세요.
# ─────────────────────────────────────────────────────────────

# ===== SSL-VPN (공공존 VPC, OpenVPN 기반) =====
# VPN_SERVER/PORT 는 인증 포털 API(/api/v3/authstate) 주소입니다.
# 가이드 기준 게이트웨이. 운영진 공지와 다르면 교체하세요.
VPN_SERVER=sslvpn-kr-vpc-02.gov-ncloud.com
VPN_PORT=8443
VPN_ID=
VPN_PW=
# OTP(이메일/SMS 1회용 코드)는 연결 시점에 터미널에서 직접 입력합니다.
#
# 프로필 이름: 테넌트마다 번호가 다릅니다. "1차 인증은 되는데 프로필을 못 받음"
# (ovpn file not found ...) 이 뜨면, 이 값을 올바른 번호로 바꾸세요.
#   - 번호는 운영진에게 'SSL-VPN 프로필/서버 번호' 로 문의하면 됩니다. 예: vpn2051.ovpn
VPN_OVPN_NAME=vpn2033.ovpn
#
# (대안) 공식 Agent(Windows/macOS)에서 받은 .ovpn 파일이 있으면,
# 그 파일을 ./transfer/naver-vpn.ovpn 로 두면 VPN_OVPN_NAME 과 무관하게 바로 사용합니다.
# 다른 경로를 쓰려면 아래에 컨테이너 기준 경로를 지정하세요.
# VPN_PROFILE=/work/transfer/naver-vpn.ovpn

# ===== 일반 서버 =====
GENERAL_HOSTNAME=
GENERAL_IP=
GENERAL_USER=ncloud
GENERAL_PASSWORD=
GENERAL_SSH_PORT=22

# ===== GPU 서버 =====
GPU_HOSTNAME=
GPU_IP=
GPU_USER=ncloud
GPU_PASSWORD=
GPU_SSH_PORT=22
