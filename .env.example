# ─────────────────────────────────────────────────────────────
# 2026 해커톤 서버 접속 설정  (복사해서 .env 로 저장 후 값을 채우세요)
#   cp .env.example .env
#
# ⚠️  .env 파일은 절대 커밋되지 않습니다 (.gitignore 등록됨).
#     VPN/서버 비밀번호·OTP를 타인과 공유하지 마세요.
# ─────────────────────────────────────────────────────────────

# ===== SSL-VPN (공공존 VPC, OpenVPN 기반) =====
# VPN_SERVER/PORT 는 인증 포털 API(/api/v3/authstate) 주소입니다.
# 가이드 기준 게이트웨이. 운영진 공지와 다르면 교체하세요.
VPN_SERVER=sslvpn-kr-vpc-02.gov-ncloud.com
VPN_PORT=8443
VPN_ID=
VPN_PW=
# OTP(이메일/SMS 1회용 코드)는 연결 시점에 터미널에서 "한 번만" 입력합니다.
# 올바른 프로필(.ovpn)은 공식 Agent와 동일한 2단계 API로 자동 수신하므로,
# 프로필 번호를 따로 알 필요가 없습니다. (설정할 것은 ID/PW 뿐)
#
# (선택) 클라이언트 버전. 보통 기본값 그대로 두면 됩니다.
# VPN_CLIENT_VERSION=1.1.4
#
# 참고: OTP 2차 인증을 쓰는 한, 연결할 때마다 OTP를 /api/v3/profile 로 제출해
# 프로필을 새로 받습니다(그래야 터널 인증이 됩니다). OTP 재입력 없이 쓰려면
# 컨테이너를 켜 두세요(tun 이 살아 있으면 즉시 사용). 완전 초기화는 'just remove'.
#
# (선택) 공식 Agent에서 받은 .ovpn 파일을 직접 쓰고 싶다면(OTP가 없는 테넌트 한정),
# 그 파일을 ./transfer/naver-vpn.ovpn 로 두면 그 파일을 사용합니다.
# 다른 경로를 쓰려면 아래에 컨테이너 기준 경로를 지정하세요.
# VPN_PROFILE=/work/transfer/naver-vpn.ovpn

# ===== 일반 서버 =====
GENERAL_HOSTNAME=
GENERAL_IP=
GENERAL_USER=ncloud
GENERAL_PASSWORD=
GENERAL_SSH_PORT=22

# ===== GPU 서버 =====
GPU_HOSTNAME=
GPU_IP=
GPU_USER=ncloud
GPU_PASSWORD=
GPU_SSH_PORT=22
